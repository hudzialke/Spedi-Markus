rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) { return request.auth != null && request.auth.uid == userId; }
    match /users/{userId} { allow read, write: if owner(userId); }
    match /users/{userId}/{collection}/{document=**} {
      allow read: if owner(userId);
      allow write: if owner(userId)
        && collection != 'driver_schedules';
    }
    // Only Spedi/Admin SDK publishes schedules. Android keeps all edits locally.
  }
}
